# Copy this file to .env and fill in your key.
# Get a free Gemini key at https://aistudio.google.com/apikey  (no card needed)
GOOGLE_API_KEY=

# LLM and embeddings (defaults are fine to start)
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=models/gemini-embedding-001

# Chunking (these are config knobs so we can ablate them in Phase 4)
CHUNK_STRATEGY=recursive
CHUNK_SIZE=800
CHUNK_OVERLAP=120
